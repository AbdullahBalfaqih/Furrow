# ============================================================
# Furrow Chain — Environment Variables Example
# Copy this file to .env.local and fill in real values
# NEVER commit .env or .env.local to git!
# ============================================================

# Supabase (use anon/publishable key only - never service_role key on client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY_HERE
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_YOUR_KEY_HERE

# JWT Secret — generate with: openssl rand -base64 64
JWT_SECRET=your-64-char-random-secret-here

# AI / OpenRouter
OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY_HERE

# 0G Blockchain (server-side only — never NEXT_PUBLIC_)
OG_RPC_URL=https://evmrpc.0g.ai
# PRIVATE_KEY=your-wallet-private-key (NEVER commit this!)
