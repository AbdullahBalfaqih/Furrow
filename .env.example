# Private key for 0G Galileo Testnet deployment (Do NOT commit real keys!)
PRIVATE_KEY=your_private_key_here

# 0G Galileo Testnet Official RPC Endpoint
OG_RPC_URL=https://evmrpc-testnet.0g.ai

# 0G Galileo Testnet Explorer URL
OG_EXPLORER_URL=https://chainscan-galileo.0g.ai

# Enterprise Cloud Database (Supabase / PostgreSQL)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
